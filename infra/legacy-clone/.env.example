# Copy to .env (never commit .env). Generate values with: openssl rand -hex 24
DB_NAME=marketcity_clone
DB_USER=clone
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Table prefix of the production database (check the SQL dump: CREATE TABLE `xxx_options`)
TABLE_PREFIX=wp_
# Production URL found in the dump, and the local URL of the clone
SOURCE_URL=https://marketcity.co
CLONE_URL=http://localhost:8080
CLONE_PORT=8080
MAIL_PORT=8025
